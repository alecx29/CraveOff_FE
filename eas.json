{
  "cli": {
    "version": ">= 14.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "store",
      "channel": "preview"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production"
    },
    "release": {
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "release"
    },
    "appleSignIn": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "enterpriseProvisioning": "adhoc"
      },
      "channel": "apple-signin"
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "simulator"
    }
  },
  "submit": {
    "production": {},
    "release": {}
  }
}
